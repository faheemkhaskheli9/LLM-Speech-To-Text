# OpenAI API key used to authenticate the server's realtime transcription
# WebSocket connection (see README.md "Architecture"). Never commit a real
# key -- copy this file to .env and fill in your own.
OPENAI_API_KEY=your-openai-api-key-here

# Comma-separated list of allowed CORS origins (default: localhost only).
# Set to "*" to explicitly opt into a wildcard -- credentials are then
# disabled automatically since browsers reject wildcard-origin + credentials.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
